{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio for a software/IT professional — Next.js on Cloudflare Workers, trilingual (EN/FR/AR), design-system driven.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run build && wrangler deploy --config wrangler.worker.jsonc",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.jsonc",
    "deploy:pages": "npm run build && wrangler pages deploy out --project-name benseba-lounes",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:d1:create": "wrangler d1 create portfolio-db",
    "cf:d1:migrate": "wrangler d1 migrations apply portfolio-db --remote",
    "cf:d1:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "cf:kv:create:cache": "wrangler kv namespace create NEXT_INC_CACHE_KV",
    "cf:kv:create:stats": "wrangler kv namespace create STATS",
    "cf:r2:create": "wrangler r2 bucket create portfolio-media",
    "cf:vectorize:create": "wrangler vectorize create portfolio-content --dimensions=1024 --metric=cosine",
    "verify": "npm run typecheck && npm run lint && npm run audit:contrast && npm run test"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
