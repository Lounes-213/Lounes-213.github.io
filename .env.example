# ─────────────────────────────────────────────────────────────────────────────
# Environment contract.
#
# Two very different kinds of variable live here — do not mix them up:
#
#   NEXT_PUBLIC_*   Inlined into the client bundle at BUILD time. Never secret.
#                   Local dev: copy to .env.local. Workers Builds: add as
#                   *build* variables so the prerender pass can read them.
#
#   Runtime secrets  Read by the worker at REQUEST time through the
#                   CloudflareEnv bindings (never inlined, never bundled).
#                   Local dev: `wrangler secret put NAME` or .dev.vars.
#                   Production: `wrangler secret put NAME --env production`.
#
# Non-secret runtime configuration (model names, limits, mail addresses) lives
# in wrangler.jsonc `vars`, so the worker and the deployment stay in sync.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public, build-time ──────────────────────────────────────────────────────

# Canonical origin, used for metadataBase, hreflang, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://portfolio.example.com

# Cloudflare Turnstile *site* key (public by design). Use the always-passing
# test keys in local development: 1x00000000000000000000AA (visible widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Enables the analytics beacon; the token is a public write-only identifier.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Feature flags read at build time by the availability badge and the assistant
# entry point. Runtime demos keep working with these unset.
NEXT_PUBLIC_ASSISTANT_ENABLED=true
NEXT_PUBLIC_DEV_STATS_ENABLED=true
NEXT_PUBLIC_3D_HERO_ENABLED=true

# ── Runtime secrets (worker only) ───────────────────────────────────────────

# Turnstile secret key (server-side verification).
# Test key that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Transactional email. MAIL_PROVIDER selects the transport in src/server/mail:
#   resend       → set RESEND_API_KEY
#   mailchannels → set MAILCHANNELS_API_KEY (legacy) or route via Email Routing
RESEND_API_KEY=
MAILCHANNELS_API_KEY=

# GitHub profile feed for the "live developer stats" section. A read-only
# fine-grained PAT without any repository scopes is enough; without it the
# widget silently falls back to the cached/fixture data in src/content.
GITHUB_TOKEN=

# Optional developer-telemetry widgets.
WAKATIME_API_KEY=

# Admin token protecting content revalidation and stats refresh endpoints.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Salt used when hashing visitor IPs before they touch D1 (privacy-friendly
# rate limiting and submission de-duplication). Rotating it invalidates the
# hashes, which is harmless by design.
IP_HASH_SALT=
